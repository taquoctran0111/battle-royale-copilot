# Tên TikTok (không cần @) của host đang LIVE
TIKTOK_USERNAME=ten_host_dang_live

# Cổng HTTP + WebSocket (dùng chung 1 port)
PORT=3000

# true = dùng mockAdapter (không cần LIVE). Nếu thiếu TIKTOK_USERNAME server cũng tự dùng mock.
USE_MOCK=true

# Cường độ mock: low | medium | high
MOCK_INTENSITY=medium

# (Tuỳ chọn) Euler Stream sign API key nếu bị giới hạn tốc độ khi ký kết nối
# TIKTOK_SIGN_API_KEY=
